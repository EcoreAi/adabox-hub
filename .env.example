# Chiave segreta: generala con  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambiami
# True solo in sviluppo. Con False si attivano cookie secure, proxy header e logging su file.
DEBUG=True
# Host ammessi, separati da virgola (es. app.cliente.it,10.0.0.5)
ALLOWED_HOSTS=localhost,127.0.0.1
# Origini fidate per CSRF quando si sta dietro a un proxy HTTPS (es. https://app.cliente.it)
CSRF_TRUSTED_ORIGINS=
# Database: sqlite di default; Postgres es. postgres://utente:password@localhost:5432/nomedb
DATABASE_URL=sqlite:///db.sqlite3
# Destinatari delle mail di errore 500 (Nome:email, separati da virgola)
ADMINS=
# SMTP per le mail di errore (senza: stampate sulla console). Es. con STARTTLS sulla 587:
# EMAIL_URL=smtp+tls://utente:password@smtp.example.com:587
# Mittente delle mail (usato anche come SERVER_EMAIL), es. noreply@cliente.it
# DEFAULT_FROM_EMAIL=
# Tentativi di login falliti prima del blocco, e durata del blocco in minuti
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
# Solo produzione: 1 per forzare https (dietro proxy che passa X-Forwarded-Proto)
SECURE_SSL_REDIRECT=False
# HSTS: lasciare 0 finché il 443 non è verificato; poi es. 31536000
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Solo per provare DEBUG=False in locale su http (in produzione lasciare commentate: default True)
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# Moduli: cartella degli addons (default ./addons, contiene installed.json)
# ADDONS_DIR=
# Backup automatici prima di installare/aggiornare/disinstallare moduli, e quanti conservarne
# BACKUP_DIR=
# BACKUP_CONSERVA=10
# Ricarica dopo un cambio di moduli: gunicorn|runserver|none (default: runserver con DEBUG, altrimenti gunicorn)
# RELOAD_STRATEGY=
# Pidfile di gunicorn, usato per la ricarica con SIGHUP
# GUNICORN_PIDFILE=/tmp/gunicorn.pid
# --- Servizi del kernel ---
# Lavori in background eseguiti subito (sviluppo). In produzione False e un container `worker`.
# LAVORI_SINCRONI=True
# Allegati: cartella privata, dimensione massima, download tramite nginx (X-Accel-Redirect)
# PRIVATE_MEDIA_ROOT=
# ALLEGATI_MAX_MB=20
# ALLEGATI_X_ACCEL=False
# Base dei link nelle email
# SITO_URL=https://hub.cliente.it
# Risposte alle notifiche: casella che accetta indirizzi +token (es. risposte+abc@cliente.it) e accesso IMAP
# EMAIL_RISPOSTE=risposte@cliente.it
# IMAP_URL=imaps://utente:password@mail.cliente.it:993/INBOX
# --- Distribuzione dei moduli ---
# Chiavi pubbliche fidate per i pacchetti (base64, da `manage.py modulo chiavi`), separate da virgola
# MODULI_CHIAVI_FIDATE=
# Firma obbligatoria (default: True in produzione, False con DEBUG)
# MODULI_FIRMA_OBBLIGATORIA=True
# MODULI_ZIP_MAX_MB=20
# Catalogo dei moduli approvati (indice.json firmato)
# MODULI_CATALOGO_URL=https://moduli.ichnobyte.it/indice.json
