# L'immagine per i clienti: kernel e tema, nessun modulo. I moduli arrivano dal portale secondo la licenza, nel volume
# addons/: sul server del cliente non c'è il codice di quelli che non ha comprato.
# docker build -f deploy/Dockerfile.cliente -t adabox_hub_cliente:<versione> .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LICENZA_OBBLIGATORIA=True \
    MODULI_FIRMA_OBBLIGATORIA=True

RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client \
       libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app/
RUN mkdir -p /app/addons && chmod +x deploy/entrypoint.sh

EXPOSE 8000

CMD ["sh", "deploy/entrypoint.sh"]
